# Leitwarte-Defaults: Dashboard bleibt dauerhaft sichtbar.
# Ueberschreibbar pro User (dconf local.d ist nur der Default, kein Lock).
[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'

[org/gnome/desktop/screensaver]
lock-enabled=false
